{
  "name": "jelly-functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test:unit": "vitest run unit",
    "test:emulator": "npm run build && firebase emulators:exec --project demo-jelly --only firestore,functions \"vitest run\"",
    "backfill": "tsx scripts/backfill.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vitest": "^3.0.7"
  }
}
