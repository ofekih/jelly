{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.local", "test", "scripts"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/!(*.*)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/@(index.html|version.json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/api/@(tmdb|books)/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=604800" }]
      },
      {
        "source": "/api/bgg/search",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=604800" }]
      },
      {
        "source": "/api/igdb/search",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=604800" }]
      },
      {
        "source": "/api/@(bgg|igdb)/price",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/tmdb/**",
        "function": { "functionId": "tmdb", "region": "us-central1" }
      },
      {
        "source": "/api/books/**",
        "function": { "functionId": "books", "region": "us-central1" }
      },
      {
        "source": "/api/bgg/**",
        "function": { "functionId": "bgg", "region": "us-central1" }
      },
      {
        "source": "/api/igdb/**",
        "function": { "functionId": "igdb", "region": "us-central1" }
      },
      {
        "source": "/l/**",
        "function": { "functionId": "sharePage", "region": "us-central1" }
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "jelly",
        "supportEmail": "ofek.gila@gmail.com"
      }
    }
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "auth": { "port": 9099 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  }
}
