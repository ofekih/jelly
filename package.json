{
  "name": "palate-ranker",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-jelly-sync \"vitest run --config vitest.emulator.config.ts\"",
    "dev:emu": "firebase emulators:exec --only firestore,auth --project demo-jelly-dev \"tsx scripts/emulator/seed.ts && vite --mode emulator --port 5180 --strictPort\"",
    "seed:emu": "tsx scripts/emulator/seed.ts",
    "test:e2e": "playwright test",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^13.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
